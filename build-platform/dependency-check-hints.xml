<hints xmlns="https://jeremylong.github.io/DependencyCheck/dependency-hint.1.4.xsd"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-hint.1.4.xsd
                           https://dependency-check.github.io/DependencyCheck/dependency-hint.1.4.xsd">
  <hint>
    <notes><![CDATA[
    Internal GoCD modules don't need to be matched based on metadata like this.
    ]]></notes>
    <given>
      <evidence type="vendor" name="groupid" value="com.thoughtworks.go"/>
    </given>
    <remove>
      <evidence type="vendor" name="groupid" value=".*" regex="true"/>
      <evidence type="vendor" name="artifactid" value=".*" regex="true"/>
      <evidence type="vendor" name="name" value=".*" regex="true"/>
      <evidence type="vendor" name="package name" value=".*" regex="true"/>
      <evidence type="product" name="artifactid" value=".*" regex="true"/>
      <evidence type="product" name="name" value=".*" regex="true"/>
      <evidence type="product" name="package name" value=".*" regex="true"/>
      <evidence type="product" name="Implementation-Title" value=".*" regex="true"/>
    </remove>
  </hint>
  <hint>
    <notes><![CDATA[
    Plugins don't need to be matched based on metadata like this.
    ]]></notes>
    <given>
      <evidence type="vendor" name="package name" value="go"/>
    </given>
    <remove>
      <evidence type="vendor" name="name" value=".*" regex="true"/>
      <evidence type="vendor" name="package name" value=".*" regex="true"/>
      <evidence type="product" name="name" value=".*" regex="true"/>
      <evidence type="product" name="package name" value=".*" regex="true"/>
      <evidence type="product" name="Implementation-Title" value=".*" regex="true"/>
    </remove>
  </hint>
</hints>
